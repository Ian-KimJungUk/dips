PORT=3000
DATABASE_URL=postgres://dips:dips@localhost:5432/dips
DATABASE_POOL_MAX=10
# 재고 차감 전략 (naive | atomic-update | pessimistic-lock | optimistic-lock | redis-lua)
STOCK_STRATEGY=naive
# optimistic-lock의 재시도 상한 (첫 시도 제외, 0 이상의 정수). 넘기면 503
STOCK_OPTIMISTIC_MAX_RETRIES=10
# redis-lua가 Redis 현재값을 DB에 반영하는 주기 (ms, 양의 정수)
STOCK_REDIS_FLUSH_INTERVAL_MS=100
REDIS_URL=redis://localhost:6379
